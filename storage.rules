rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Seluruh upload dan unduh file privat divalidasi oleh backend server
    // All private uploads and downloads are validated by backend server
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Foto website pameran dibuka publik; unggahan tetap lewat skrip admin
    // Exhibition website photos are publicly readable; uploads still go through the admin script
    match /pameran/{allPaths=**} {
      allow read: if true;
    }
  }
}
