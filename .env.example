# Firebase klien (dibaca peramban, ikut ter-bundle saat build)
# Firebase client (read by the browser, baked in at build time)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase server / Firebase server
# Salin dari service account JSON: project_id, client_email, private_key.
# Copy from the service account JSON: project_id, client_email, private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Sesi / Session
SESSION_COOKIE_NAME=__session
SESSION_EXPIRES_DAYS=5

# Penanda tangan token QR presensi. Wajib di produksi -- aplikasi menolak start
# tanpa ini. Buat dengan: openssl rand -base64 32
#
# Attendance QR token signing key. Mandatory in production -- the app refuses to
# start without it. Generate with: openssl rand -base64 32
QR_TOKEN_SECRET=

# Jembatan Google Calendar (Apps Script). Kosongkan bila Workspace belum siap --
# mentoring tetap dapat dipesan, hanya tanpa tautan Meet otomatis.
# Lihat scripts/apps-script/Code.gs untuk cara pasang.
#
# Google Calendar bridge (Apps Script). Leave empty while Workspace is not ready
# -- mentoring stays bookable, just without an automatic Meet link.
# See scripts/apps-script/Code.gs for setup.
GOOGLE_CALENDAR_GAS_URL=
GOOGLE_CALENDAR_GAS_SECRET=

# URL Aplikasi / Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
